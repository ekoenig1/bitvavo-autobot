# Bitvavo-Autobot – Konfiguration für Docker
# Kopieren mit: cp .env.example .env  -> dann Werte anpassen!

# Geheimer Schlüssel für die Session (unbedingt ändern!)
FLASK_SECRET_KEY=bitte-aendern-mit-langem-zufaelligem-string

# Schlüssel für die Secret-Verschlüsselung – erzeugen mit: openssl rand -hex 32
# Achtung: Beim ersten Setzen werden Klartext-Secrets automatisch verschlüsselt.
ENCRYPTION_KEY=bitte-aendern-64-hex-zeichen

# Master-Passwort für den Login (unbedingt ändern!)
MASTER_PASSWORD=bitmaster

# true = keine echten Orders, nur Simulation
SIMULATION_MODE=false

# Zeitzone für den Scheduler
TZ=Europe/Berlin

# Pfade innerhalb des Containers (Volume /app/data)
DB_PATH=data/bitmaster.db
LOG_FILE=data/bitmaster.log